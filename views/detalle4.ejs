<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ducati Panigale V4 R | Ciencia de la Velocidad</title>
    <link rel="icon" type="image/png" href="/img/logo/logo.png">
    <link rel="apple-touch-icon" href="/img/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;900&family=JetBrains+Mono:wght@400;700&display=swap');

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #000;
            color: #fff;
            margin: 0;
            overflow-x: hidden;
        }

        
        .btn-paddock-back {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.15em;
            padding: 8px 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.03);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: center;
            gap: 10px;
            text-transform: uppercase;
            color: #fff;
            clip-path: polygon(0 0, 100% 0, 95% 100%, 5% 100%);
        }

        .btn-paddock-back:hover {
            background: #fff;
            color: #000;
            border-color: #fff;
            transform: translateY(-1px);
        }

        .wrapper-360 {
            perspective: 1500px;
            width: 100%;
            height: 350px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            touch-action: none;
        }

        #moto-ducati {
            width: 90%;
            max-width: 850px;
            transition: transform 0.1s ease-out, filter 0.8s ease;
            filter: brightness(0.1);
            transform-style: preserve-3d;
        }

        .engine-on #moto-ducati {
            filter: brightness(1) drop-shadow(0 0 50px rgba(220, 38, 38, 0.4));
        }

        .hotspot {
            position: absolute;
            width: 24px;
            height: 24px;
            background: #dc2626;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 100;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0;
            transform: scale(0);
        }

        .engine-on .hotspot {
            opacity: 1;
            transform: scale(1);
        }

        .hotspot::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: #dc2626;
            border-radius: 50%;
            animation: pulse-red 2s infinite;
        }

        @keyframes pulse-red {
            0% {
                transform: scale(1);
                opacity: 0.6;
            }

            100% {
                transform: scale(2.5);
                opacity: 0;
            }
        }

        .hotspot-card {
            position: absolute;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%);
            width: 220px;
            background: #111;
            border: 1px solid #dc2626;
            color: white;
            padding: 15px;
            border-radius: 2px;
            font-size: 11px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
            z-index: 110;
        }

        .hotspot:hover .hotspot-card {
            opacity: 1;
            visibility: visible;
            bottom: 45px;
        }

        .telemetry-track {
            font-family: 'JetBrains Mono', monospace;
            background: rgba(15, 15, 15, 0.95);
            border-right: 4px solid #dc2626;
            padding: 25px;
            backdrop-filter: blur(15px);
        }

        
        .bento-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        @media (min-width: 768px) {
            .bento-container {
                grid-template-columns: repeat(4, 1fr);
                grid-template-rows: repeat(2, 250px);
            }

            .video-large {
                grid-column: span 2;
                grid-row: span 2;
            }

            .photo-side {
                grid-column: span 2;
            }

            .wrapper-360 {
                height: 550px;
            }
        }

        .bento-item {
            position: relative;
            overflow: hidden;
            background: #0a0a0a;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .bento-item img,
        .bento-item video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.8s;
        }

        .bento-item:hover img {
            transform: scale(1.1);
        }

        
        .spec-card {
            background: rgba(10, 10, 10, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .spec-card:hover {
            border-color: #dc2626;
            background: rgba(220, 38, 38, 0.02);
        }

        .btn-v4r {
            background: #dc2626;
            color: #fff;
            padding: 16px 40px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            transition: 0.3s;
            clip-path: polygon(5% 0, 100% 0, 95% 100%, 0 100%);
            border: none;
            cursor: pointer;
            font-style: italic;
        }

        .vibrando-v4 {
            animation: v4-vibration 0.04s infinite;
        }

        @keyframes v4-vibration {
            0% {
                transform: rotateY(var(--rot, 0deg)) translate(1px, 1px);
            }

            50% {
                transform: rotateY(var(--rot, 0deg)) translate(-1px, -1px);
            }

            100% {
                transform: rotateY(var(--rot, 0deg)) translate(1px, -1px);
            }
        }
    </style>
</head>

<body>

    <div id="modalCompra"
        class="fixed inset-0 z-[5000] hidden bg-black/98 backdrop-blur-xl flex items-center justify-center p-4">
        <div class="bg-zinc-950 border border-red-600/20 w-full max-w-lg p-10 relative">
            <div class="flex items-center gap-3 mb-8">
                <i class="fa-solid fa-microchip text-red-600 text-xs"></i>
                <p class="text-[9px] font-black uppercase tracking-[0.3em] text-zinc-400">Configuración de Entrega V4 R
                </p>
            </div>
            <h3 class="text-4xl font-black uppercase italic mb-8 leading-none">Reservar <br><span
                    class="text-red-600">La Excelencia.</span></h3>

            <form action="/comprar/<%= moto._id %>" method="POST" class="space-y-6">
                <div>
                    <label class="text-[8px] font-black uppercase text-zinc-500 block mb-2 italic">Concesionario
                        Oficial</label>
                    <select id="selectSede" name="sedeElegida" required
                        class="w-full bg-zinc-900 border border-zinc-800 p-4 text-xs font-bold text-white outline-none focus:border-red-600 appearance-none cursor-pointer">
                        <option value="Caracas, Venezuela">Garage Las Mercedes, Caracas</option>
                        <option value="Roma, Italia">Ducati Italia, Roma</option>
                        <option value="Madrid, España">Ducati España, Madrid</option>
                        <option value="Miami, Usa">Ducati USA, Miami </option>
                        <option value="Tokyo, Japan">Ducati Tokyo, Nishi</option>
                        <option value="Dubai, UAE">Ducati Dubai, Wheels of Arabia</option>
                        <option value="Dubai, UAE">Ducati Germany, Munich</option>
                    </select>
                </div>
                <div>
                    <label class="text-[9px] font-bold uppercase block mb-2 font-mono">Fecha de retiro</label>
                    <input type="date" id="fechaEntrega" name="fechaEntrega" required
                        class="w-full border-2 border-zinc-900 p-4 text-xs font-bold outline-none bg-zinc-900 text-white focus:bg-white focus:text-black">
                </div>
                <div class="mt-6 flex gap-3 p-4 bg-zinc-100 border-l-4 border-red-600">
                    <i class="fa-solid fa-location-dot text-[10px] mt-1 text-black"></i>
                    <p class="text-[10px] leading-tight text-zinc-700 font-mono uppercase">El retiro será en: <br>
                        <span id="sede-display" class="text-black font-black text-xs">Garage Las Mercedes,
                            Caracas</span>
                    </p>
                </div>
                <div class="border-y border-zinc-800 py-4 my-6">
                    <p class="text-3xl font-black italic text-white">€ <%= moto.precio %>
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <button type="button" onclick="cerrarModal()"
                        class="text-[10px] font-black uppercase hover:underline">Ahora no</button>
                    <button type="submit"
                        class="bg-red-600 text-white p-4 text-[10px] font-black uppercase hover:bg-zinc-800 transition">Confirmar
                        Reserva</button>
                </div>
            </form>
        </div>
    </div>

    <nav
        class="fixed top-0 w-full z-[500] bg-black/80 backdrop-blur-md border-b border-white/5 p-5 flex justify-between items-center">
        <div class="flex items-center gap-4">
            <img src="/img/logo/logo.png" alt="Ducati" class="h-4">
            <a href="/"
                class="text-[9px] font-bold uppercase tracking-widest border border-white/10 px-4 py-2 hover:bg-white hover:text-black transition">Volver
                al inicio</a>
        </div>
        <div class="flex items-center gap-8">
            <div class="flex gap-6 items-center">
                <% if (session) { %>
                    <a href="/perfil"
                        class="text-[10px] font-black uppercase text-white hover:text-red-600 transition italic">PERFIL</a>
                    <a href="/logout"
                        class="text-[10px] font-black uppercase text-zinc-500 hover:text-white transition">SALIR</a>
                    <% } else { %>
                        <a href="/login"
                            class="text-[10px] font-black uppercase text-white hover:text-red-600 transition">LOGIN</a>
                        <a href="/registro"
                            class="bg-white text-black px-4 py-2 text-[10px] font-black uppercase hover:bg-red-600 hover:text-white transition">REGISTRO</a>
                        <% } %>
            </div>
        </div>
    </nav>

    <section class="relative min-h-screen flex items-center justify-center pt-20">
        <div class="container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16">
            <div class="space-y-10">
                <header>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="h-[1px] w-12 bg-red-600"></span>
                        <span class="text-red-600 text-xs font-mono tracking-[0.4em] uppercase">The Science of
                            Speed</span>
                    </div>
                    <h1 class="text-6xl md:text-9xl font-black italic mb-6 uppercase leading-[0.85]">VELOCIDAD <br><span
                            class="text-white">PURA.</span></h1>

                    <div class="flex items-center gap-2 mb-6 border-l-2 border-red-600 pl-4">
                        <i class="fa-solid fa-shield-halved text-red-600 text-[10px]"></i>
                        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-400">4 Ever Ducati // 4
                            años de garantía oficial</p>
                    </div>

                    <div class="flex gap-4 mb-8">
                        <div class="telemetry-track">
                            <p class="text-[8px] text-zinc-500 uppercase font-bold italic">RPM_MAX</p>
                            <span id="val-rpm" class="text-2xl font-black italic">0</span>
                        </div>
                        <div class="telemetry-track">
                            <p class="text-[8px] text-zinc-500 uppercase font-bold italic">TEMP_OIL</p>
                            <span id="val-temp" class="text-2xl font-black italic">22°C</span>
                        </div>
                    </div>
                </header>

                <div class="flex items-center gap-8">
                    <div class="relative">
                        <div id="hint-start"
                            class="absolute -top-10 left-0 bg-red-600 text-white text-[8px] font-black px-2 py-1 uppercase animate-bounce">
                            START ENGINE
                        </div>
                        <button id="btn-start"
                            class="w-16 h-16 rounded-full border-2 border-red-600 flex items-center justify-center hover:bg-red-600 group transition-all duration-500 shadow-[0_0_15px_rgba(220,38,38,0.3)]">
                            <i class="fa-solid fa-power-off text-xl text-red-600 group-hover:text-white"></i>
                        </button>
                    </div>
                    <button onclick="abrirModal()" class="btn-v4r shadow-[10px_10px_0px_rgba(220,38,38,0.1)]">Reservar</button>
                </div>
            </div>

            <div class="wrapper-360" id="sensor-giro">
                <div class="absolute top-0 right-0 telemetry-track z-50">
                    <p class="text-[8px] text-zinc-500 uppercase tracking-widest mb-2 italic">Inclinación</p>
                    <span id="txt-grados" class="text-4xl font-black italic text-white">0°</span>
                </div>

                <div class="relative w-[90%] max-w-[850px] flex items-center justify-center">

                    <div class="hotspot" style="top: 30%; left: 35%;">
                        <i class="fa-solid fa-wind text-[10px] text-white"></i>
                        <div class="hotspot-card">
                            <p class="font-black uppercase text-red-600 mb-1">Aerodinámica</p>
                            <p>Alas de carbono: 37kg de downforce.</p>
                        </div>
                    </div>

                    <div class="hotspot" style="top: 55%; left: 55%;">
                        <i class="fa-solid fa-fire text-[10px] text-white"></i>
                        <div class="hotspot-card">
                            <p class="font-black uppercase text-red-600 mb-1">V4 Stradale</p>
                            <p>998cc / 16,500 rpm. ADN de MotoGP.</p>
                        </div>
                    </div>

                    <div class="hotspot" style="top: 75%; left: 30%;">
                        <i class="fa-solid fa-circle-dot text-[10px] text-white"></i>
                        <div class="hotspot-card">
                            <p class="font-black uppercase text-red-600 mb-1">Brembo Stylema</p>
                            <p>Frenada de competición máxima.</p>
                        </div>
                    </div>

                    <img id="moto-ducati" src="<%= moto.img %>" alt="<%= moto.nombre %>" class="w-full h-auto">
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-zinc-950 border-y border-white/5">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl font-black italic uppercase mb-12 text-white/10 tracking-tighter">Technical_Data_Sheet
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="spec-card">
                    <p class="text-red-600 font-mono text-[10px] mb-2 uppercase italic">// Potencia Máxima</p>
                    <p class="text-2xl font-black italic uppercase leading-tight">218 CV @ 15,500 rpm</p>
                </div>
                <div class="spec-card">
                    <p class="text-red-600 font-mono text-[10px] mb-2 uppercase italic">// Electrónica</p>
                    <p class="text-2xl font-black italic uppercase leading-tight">Ducati Traction Control EVO 3</p>
                </div>
                <div class="spec-card">
                    <p class="text-red-600 font-mono text-[10px] mb-2 uppercase italic">// Suspensión</p>
                    <p class="text-2xl font-black italic uppercase leading-tight">Öhlins NPX 25/30 Presurizada</p>
                </div>
                <div class="spec-card">
                    <p class="text-red-600 font-mono text-[10px] mb-2 uppercase italic">// Chasis</p>
                    <p class="text-2xl font-black italic uppercase leading-tight">Front Frame de Aluminio</p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-black overflow-hidden">
        <div class="container mx-auto px-6 flex flex-col lg:flex-row gap-16 items-center">
            <div class="w-full lg:w-1/2 relative">
                <div class="flex items-center gap-4 mb-6">
                    <span class="h-[2px] w-20 bg-red-600"></span>
                    <span class="text-red-600 font-black italic uppercase text-xs">Official Factory Build</span>
                </div>
                <h2 class="text-5xl md:text-8xl font-black italic uppercase leading-[0.85] mb-8">BORGO <br><span
                        class="text-red-600">PANIGALE.</span></h2>
                <p class="text-zinc-500 font-mono text-sm uppercase leading-relaxed max-w-md mb-10">La máxima expresión
                    de Estilo, Sofisticación y Performance. Fabricada artesanalmente en Bolonia para conquistar el
                    cronómetro.</p>
                <div class="flex gap-10">
                    <div>
                        <p class="text-4xl font-black italic mb-1">998</p>
                        <p class="text-[9px] font-bold text-zinc-600 uppercase tracking-widest italic">Cilindrada SBK
                        </p>
                    </div>
                    <div>
                        <p class="text-4xl font-black italic mb-1">167kg</p>
                        <p class="text-[9px] font-bold text-zinc-600 uppercase tracking-widest italic">Peso en seco</p>
                    </div>
                </div>
            </div>
            <div class="w-full lg:w-1/2">
                <div class="bento-container">
                    <div class="bento-item video-large">
                        <video autoplay loop muted playsinline
                            class="grayscale hover:grayscale-0 transition-all duration-1000">
                            <source src="/img/detalle/panigalevideo.mov" type="video/mp4">
                        </video>
                    </div>
                    <div class="bento-item photo-side">
                        <img src="/img/detalle/Panigale-V4-R-overview-gallery-mosaic-1920x1080-4.jpg">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-black py-24 border-t border-zinc-900">
        <div class="container mx-auto px-6 text-center">
            <h2 class="text-4xl md:text-6xl font-black italic uppercase mb-8 leading-none">DOMINA CADA <br><span
                    class="text-red-600 italic">ÁPICE DE LA PISTA.</span></h2>
            <button onclick="abrirModal()"
                class="group relative px-12 py-5 bg-white text-black font-black uppercase text-xs tracking-[0.3em] hover:bg-red-600 hover:text-white transition-all duration-500 italic">
                Descubrir la Bestia
                <div
                    class="absolute -bottom-2 -right-2 w-full h-full border border-red-600/30 -z-10 group-hover:bottom-0 group-hover:right-0 transition-all">
                </div>
            </button>
        </div>
    </footer>

    <audio id="audio-v4r" preload="auto">
        <source src="/img/detalle/motorcycle-77112.mp3" type="audio/mpeg">
    </audio>

    <script>
        const modal = document.getElementById('modalCompra');
        const sensor = document.getElementById('sensor-giro');
        const motoImg = document.getElementById('moto-ducati');
        const btnStart = document.getElementById('btn-start');
        const txtGrados = document.getElementById('txt-grados');
        const audio = document.getElementById('audio-v4r');
        const selectSede = document.getElementById('selectSede');
        const displaySede = document.getElementById('sede-display');
        let telemetryInterval;

        
        selectSede?.addEventListener('change', () => { displaySede.innerText = selectSede.options[selectSede.selectedIndex].text; });

        
        function abrirModal() {
            const haySesion = "<%= session ? 'true' : 'false' %>" === "true";
            if (!haySesion) {
                Swal.fire({
                    title: 'ACCESO RESTRINGIDO',
                    background: '#0a0a0a', color: '#fff',
                    showCancelButton: true, confirmButtonText: 'IR AL LOGIN', confirmButtonColor: '#dc2626',
                }).then((result) => { if (result.isConfirmed) window.location.href = '/login'; });
            } else { modal.classList.remove('hidden'); }
        }

        function cerrarModal() { modal.classList.add('hidden'); }

        
        function handleRotation(clientX) {
            const rect = sensor.getBoundingClientRect();
            const x = clientX - rect.left;
            const rotation = ((x / rect.width) - 0.5) * 60;
            motoImg.style.transform = `rotateY(${rotation}deg)`;
            motoImg.style.setProperty('--rot', `${rotation}deg`);
            txtGrados.innerText = `${Math.round(rotation)}°`;
        }

        sensor.addEventListener('mousemove', (e) => handleRotation(e.clientX));
        sensor.addEventListener('touchmove', (e) => handleRotation(e.touches[0].clientX), { passive: true });

        
        btnStart.addEventListener('click', () => {
            const isOn = document.body.classList.toggle('engine-on');
            if (isOn) {
                audio?.play().catch(() => { });
                motoImg.classList.add('vibrando-v4');
                telemetryInterval = setInterval(() => {
                    document.getElementById('val-rpm').innerText = Math.floor(Math.random() * (16500 - 15500) + 15500).toLocaleString();
                    document.getElementById('val-temp').innerText = Math.floor(Math.random() * (105 - 95) + 95) + '°C';
                }, 100);
            } else {
                audio?.pause();
                motoImg.classList.remove('vibrando-v4');
                clearInterval(telemetryInterval);
                document.getElementById('val-rpm').innerText = '0';
            }
        });
    </script>
</body>

</html>