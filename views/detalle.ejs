    <script>
        const sensor = document.getElementById('sensor-giro');
        const motoImg = document.getElementById('moto-ducati');
        const btnStart = document.getElementById('btn-start');
        const audio = document.getElementById('audio-ducati');
        const modal = document.getElementById('modalCompra');
        const txtGrados = document.getElementById('txt-grados');

        function abrirModal() {
            const haySesion = "<%= session ? 'true' : 'false' %>" === "true";
            if (!haySesion) {
                Swal.fire({
                    title: '<span style="font-family: \'Inter\'; font-weight: 900;">ACCESO RESTRINGIDO</span>',
                    html: `<div style="text-align: center;"><p style="font-family: 'JetBrains Mono'; font-size: 11px; color: #dc2626; margin-bottom: 15px;">// AUTH_REQUIRED_FOR_TRANSACTION</p><p style="font-family: 'Inter'; font-size: 14px; color: #ccc;">Debes iniciar sesión en la red oficial Ducati para reservar la <strong><%= moto.nombre %></strong>.</p></div>`,
                    background: '#050505',
                    color: '#fff',
                    showCancelButton: true,
                    confirmButtonText: 'INICIAR SESIÓN',
                    cancelButtonText: 'CANCELAR',
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#1a1a1a',
                    borderRadius: '0'
                }).then((result) => { if (result.isConfirmed) window.location.href = '/login'; });
            } else {
                document.getElementById('modalCompra').classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }
        function cerrarModal() { modal.classList.add('hidden'); document.body.style.overflow = 'auto'; }

        function handleRotation(clientX) {
            const rect = sensor.getBoundingClientRect();
            const x = clientX - rect.left;
            const rotation = ((x / rect.width) - 0.5) * 60;
            motoImg.style.transform = `rotateY(${rotation}deg)`;
            motoImg.style.setProperty('--rot', `${rotation}deg`);
            txtGrados.innerText = `${Math.round(rotation)}°`;
            document.querySelectorAll('.hotspot').forEach(h => {
                h.style.transform = `translateX(${rotation * -0.4}px) scale(1)`;
            });
        }

        sensor.addEventListener('mousemove', (e) => handleRotation(e.clientX));
        sensor.addEventListener('touchmove', (e) => {
            
            if (e.target.closest('.hotspot')) return;
            handleRotation(e.touches[0].clientX);
        }, { passive: true });

        const resetRotation = () => {
            motoImg.style.transform = 'rotateY(0deg)';
            txtGrados.innerText = '0°';
            document.querySelectorAll('.hotspot').forEach(h => h.style.transform = `translateX(0) scale(1)`);
        };
        sensor.addEventListener('mouseleave', resetRotation);
        sensor.addEventListener('touchend', (e) => {
            
            if (!e.target.closest('.hotspot')) resetRotation();
        });

        
        document.querySelectorAll('.hotspot').forEach(h => {
            h.addEventListener('click', (e) => {
                e.stopPropagation();
                const wasActive = h.classList.contains('active');
                document.querySelectorAll('.hotspot').forEach(el => el.classList.remove('active'));
                if (!wasActive) h.classList.add('active');
            });
        });

        btnStart.addEventListener('click', () => {
            const isOn = document.body.classList.toggle('engine-on');
            if (isOn) {
                audio?.play().catch(() => { });
                motoImg.classList.add('vibrando');
                btnStart.querySelector('i').className = 'fa-solid fa-stop text-2xl text-red-600';
            } else {
                audio?.pause();
                motoImg.classList.remove('vibrando');
                btnStart.querySelector('i').className = 'fa-solid fa-power-off text-2xl text-zinc-700';
            }
        });

        function setModo(m) {
            const msg = document.getElementById('modo-mensaje');
            if (m === 'sport') msg.innerHTML = "<span class='text-red-600 animate-pulse'>SPORT: Máxima respuesta del Testastretta.</span>";
            else if (m === 'touring') msg.innerHTML = "TOURING: Calibración balanceada para trayectos largos.";
            else msg.innerHTML = "URBAN: Mapeo de seguridad y entrega suave.";
        }
    </script>
</body>

</html>