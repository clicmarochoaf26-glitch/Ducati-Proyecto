<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ducati <%= moto.nombre %> | Official Experience</title>
    <link rel="icon" type="image/png" href="/img/logo/logo.png">
    <link rel="apple-touch-icon" href="/img/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap');

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #050505;
            background-image:
                linear-gradient(rgba(220, 38, 38, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(220, 38, 38, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            color: #fff;
            margin: 0;
            overflow-x: hidden;
        }

        /* --- UI COMPONENTS --- */
        .btn-nav-garage {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.2em;
            padding: 10px 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.5);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            display: flex;
            align-items: center;
            gap: 12px;
            text-transform: uppercase;
        }

        .btn-nav-garage:hover {
            border-color: #dc2626;
            color: #dc2626;
            box-shadow: 0 0 20px rgba(220, 38, 38, 0.2);
        }

        /* --- HOTSPOTS NEÓN --- */
        .hotspot {
            position: absolute;
            width: 22px;
            height: 22px;
            background: #ccff00;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 300 !important;
            /* Aumentado para estar sobre todo */
            transition: all 0.5s ease;
            opacity: 0;
            transform: scale(0);
            box-shadow: 0 0 20px rgba(204, 255, 0, 0.8);
            pointer-events: auto !important;
            /* Asegura clic */
        }

        .engine-on .hotspot {
            opacity: 1;
            transform: scale(1);
        }

        .hotspot i {
            color: #000;
            font-size: 9px;
            transition: transform 0.3s;
        }

        .hotspot:hover i {
            transform: rotate(90deg);
        }

        .hotspot::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: #ccff00;
            border-radius: 50%;
            animation: pulse-neon 1.5s infinite;
        }

        @keyframes pulse-neon {
            0% {
                transform: scale(1);
                opacity: 0.8;
            }

            100% {
                transform: scale(3.5);
                opacity: 0;
            }
        }

        .hotspot-card {
            position: absolute;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%);
            width: 180px;
            background: #fff;
            color: #000;
            padding: 15px;
            border-left: 5px solid #ccff00;
            font-size: 11px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            z-index: 310;
            pointer-events: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Soporte para hover y para clase activa en móvil */
        .hotspot:hover .hotspot-card,
        .hotspot.active .hotspot-card {
            opacity: 1;
            visibility: visible;
            bottom: 45px;
        }

        /* --- TELEMETRÍA & ENGINE --- */
        .telemetry-adventure {
            font-family: 'JetBrains Mono', monospace;
            background: rgba(0, 0, 0, 0.8);
            border-left: 3px solid #dc2626;
            padding: 15px 25px;
            backdrop-blur: 10px;
            z-index: 400;
        }

        .pointer-start {
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            color: #ccff00;
            text-transform: uppercase;
            letter-spacing: 3px;
            animation: bounceY 2s infinite;
        }

        @keyframes bounceY {

            0%,
            100% {
                transform: translateX(-50%) translateY(0);
            }

            50% {
                transform: translateX(-50%) translateY(-10px);
            }
        }

        .wrapper-360 {
            perspective: 1500px;
            width: 100%;
            height: 550px;
            position: relative;
            z-index: 50;
            touch-action: none;
            /* Evita scroll mientras giras la moto */
        }

        #moto-ducati {
            width: 100%;
            max-width: 850px;
            transition: transform 0.15s ease-out, filter 1s ease;
            filter: brightness(0.15) grayscale(100%) contrast(1.2);
            pointer-events: none;
            /* IMPORTANTE: La imagen no bloquea los clics */
            user-select: none;
        }

        .engine-on #moto-ducati {
            filter: brightness(1.1) grayscale(0%) contrast(1);
        }

        .vibrando {
            animation: vibration-mx 0.04s infinite;
        }

        @keyframes vibration-mx {
            0% {
                transform: translate(0, 0) rotateY(var(--rot, 0deg));
            }

            50% {
                transform: translate(0.5px, -0.5px) rotateY(var(--rot, 0deg));
            }

            100% {
                transform: translate(0, 0) rotateY(var(--rot, 0deg));
            }
        }

        .btn-adquirir {
            background: #dc2626;
            color: #fff;
            padding: 18px 45px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.25em;
            border: 1px solid #dc2626;
            font-style: italic;
            transition: 0.4s;
            position: relative;
            overflow: hidden;
        }

        .btn-adquirir:hover {
            background: #fff;
            color: #000;
            border-color: #fff;
            transform: translateY(-3px);
        }

        .floor-glow {
            position: absolute;
            bottom: 15%;
            width: 600px;
            height: 120px;
            background: radial-gradient(ellipse, rgba(220, 38, 38, 0.25) 0%, transparent 75%);
            filter: blur(40px);
            opacity: 0;
            transition: opacity 1.5s ease;
            pointer-events: none;
            /* No bloquea clics */
        }

        .engine-on .floor-glow {
            opacity: 1;
        }
    </style>
</head>

<body>

    <div id="modalCompra"
