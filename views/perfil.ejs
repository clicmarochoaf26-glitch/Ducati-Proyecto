<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ducati | Hangar de Competición</title>
    <link rel="icon" type="image/png" href="/img/logo/logo.png">
    <link rel="apple-touch-icon" href="/img/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@300;900&family=Space+Mono&display=swap');

        body {
            font-family: 'Lexend Deca', sans-serif;
            background: #000;
            color: white;
            background-image: radial-gradient(#1a1a1a 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .racing-border {
            position: relative;
            border: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(10, 10, 10, 0.9);
            backdrop-filter: blur(15px);
        }

        .racing-border::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 2px;
            height: 100%;
            background: #e11d48;
            box-shadow: 0 0 15px #e11d48;
        }

        .progress-step {
            transition: width 1.5s cubic-bezier(0.2, 1, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .progress-step::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            animation: scan 2s infinite;
        }

        @keyframes scan {
            0% {
                transform: translateX(-100%);
            }

            100% {
                transform: translateX(100%);
            }
        }

        .moto-main-img {
            filter: drop-shadow(0 0 45px rgba(225, 29, 72, 0.3));
            transition: all 0.5s ease;
        }

        .group:hover .moto-main-img {
            transform: scale(1.03) translateY(-10px);
            filter: drop-shadow(0 0 65px rgba(225, 29, 72, 0.6));
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: #000;
        }

        ::-webkit-scrollbar-thumb {
            background: #e11d48;
        }
    </style>
</head>

<body class="flex min-h-screen">

    <aside class="w-20 lg:w-72 bg-black border-r border-zinc-900 flex flex-col fixed h-full z-50">
        <div class="p-6 lg:p-10">
            <h1 class="text-red-600 font-black italic text-3xl uppercase tracking-tighter">D<span
                    class="text-white">C</span></h1>
            <p class="hidden lg:block text-[9px] text-zinc-500 tracking-[0.4em] font-black italic mt-2 uppercase">Hangar
                v2.0</p>
        </div>
        <nav class="flex-1 px-4 mt-10 space-y-4">
            <a href="/"
                class="flex items-center justify-center lg:justify-start gap-4 p-4 text-[11px] font-black uppercase text-zinc-400 hover:text-white border border-transparent hover:border-zinc-800 transition-all bg-zinc-900/20">
                <i class="fa-solid fa-house-chimney text-lg"></i>
                <span class="hidden lg:block tracking-widest">Volver a la Web</span>
            </a>
            <div class="h-[1px] bg-zinc-900 my-6 mx-4"></div>
            <a href="#proxima-conquista"
                class="flex items-center justify-center lg:justify-start gap-4 p-4 text-[11px] font-black uppercase hover:text-red-500 transition group">
                <i class="fa-solid fa-gauge-high text-lg"></i>
                <span class="hidden lg:block tracking-widest">Dash</span>
            </a>
            <a href="#mis-compras"
                class="flex items-center justify-center lg:justify-start gap-4 p-4 text-[11px] font-black uppercase hover:text-red-500 transition group">
                <i class="fa-solid fa-microchip text-lg"></i>
                <span class="hidden lg:block tracking-widest">Telemetría</span>
            </a>
        </nav>
    </aside>

    <main class="flex-1 ml-20 lg:ml-72 p-6 lg:p-12 bg-black/50">

        <section id="proxima-conquista" class="mb-16">
            <div class="group racing-border p-8 lg:p-16 flex flex-col lg:flex-row items-center gap-12 overflow-hidden">
                <% if (proxima) { %>
                    <div class="relative z-10 w-full lg:w-1/2 flex justify-center">
                        <img src="<%= proxima.img %>" class="moto-main-img h-64 lg:h-96 object-contain">
                    </div>
                    <div class="relative z-10 w-full lg:w-1/2">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="h-[1px] w-12 bg-red-600"></span>
                            <span class="text-red-600 font-black italic text-[10px] uppercase tracking-[0.3em]">Target
                                Locked</span>
                        </div>
                        <h2 class="text-6xl lg:text-7xl font-black uppercase italic leading-none tracking-tighter mb-6">
                            <%= proxima.nombre %>
                        </h2>
                        <div class="flex flex-wrap gap-4 mt-10">
                            <a href="/moto/<%= proxima._id %>"
                                class="bg-red-600 hover:bg-white hover:text-black text-white font-black px-12 py-5 italic uppercase text-[12px] tracking-widest transition-all">
                                Descubrir la Bestia
                            </a>
                        </div>
                    </div>
                    <% } %>
            </div>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">

            <div id="ficha-tecnica" class="lg:col-span-4">
                <div class="racing-border p-8 h-full bg-zinc-950/40 relative overflow-hidden">
                    <div class="absolute -right-10 -top-10 w-40 h-40 border border-red-600/10 rounded-full"></div>
                    <h3
                        class="text-red-600 font-black text-[10px] uppercase italic tracking-[0.4em] mb-10 flex items-center gap-2">
                        <span class="w-3 h-[1px] bg-red-600"></span> // Expediente Piloto
                    </h3>

                    <div class="relative z-10">
                        <div class="mb-10">
                            <label
                                class="text-[8px] text-zinc-500 font-black uppercase tracking-[0.2em] block mb-1">Callsign
                                / Alias</label>
                            <h4
                                class="text-4xl font-black italic uppercase text-red-600 tracking-tighter leading-tight">
                                <%= user.username %>
                            </h4>
                            <div class="flex items-center gap-2 mt-2">
                                <span
                                    class="px-2 py-0.5 bg-red-600 text-[8px] font-black text-white uppercase italic">Nivel
                                    Pro</span>
                                <span class="text-[8px] text-zinc-600 font-mono tracking-tighter">ID: DUC-<%=
                                        user._id.toString().slice(-6).toUpperCase() %></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-3">
                            <div
                                class="bg-black/50 border border-zinc-800 p-4 group hover:border-red-600/50 transition-colors">
                                <p class="text-[7px] text-red-600 font-black uppercase mb-1 tracking-widest">Nombre
                                    Oficial</p>
                                <p class="text-md font-bold italic uppercase text-zinc-200">
                                    <%= user.nombre %>
                                        <%= user.apellido %>
                                </p>
                            </div>
                            <div class="bg-black/50 border border-zinc-800 p-4">
                                <p class="text-[7px] text-red-600 font-black uppercase mb-1 tracking-widest">Enlace
                                    Comunicación</p>
                                <p class="text-xs font-mono text-zinc-400">
                                    <%= user.correo %>
                                </p>
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div class="bg-black/50 border border-zinc-800 p-4">
                                    <p class="text-[7px] text-zinc-500 font-black uppercase mb-1 tracking-widest">
                                        Licencia</p>
                                    <p class="text-[10px] font-black italic text-white uppercase">Clase A</p>
                                </div>
                                <div class="bg-black/50 border border-zinc-800 p-4 text-right">
                                    <p class="text-[7px] text-zinc-500 font-black uppercase mb-1 tracking-widest">Sector
                                    </p>
                                    <p class="text-[10px] font-black italic text-white uppercase text-red-600">
                                        <%= user.pais %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="mis-compras" class="lg:col-span-8">
                <div class="racing-border p-8 bg-zinc-950/40">
                    <h3 class="text-zinc-500 font-black text-[11px] uppercase italic tracking-[0.3em] mb-10">// Live
                        Telemetry</h3>
                    <div class="space-y-12">
                        <% if (compras && compras.length> 0) { %>
                            <% compras.forEach(function(v) { %>
                                <% var nMoto=(v.moto && v.moto.nombre) ? v.moto.nombre : "Ducati Special Edition" ; var
                                    precioStr=(v.moto && v.moto.precio) ? Number(v.moto.precio).toLocaleString('de-DE')
                                    : '0' ; var cBarra="bg-zinc-800" ; if(v.estado==="Pago Verificado" )
                                    cBarra="bg-yellow-500" ; else if(v.estado==="Enviada" ) cBarra="bg-blue-500" ; else
                                    if(v.estado==="Entregada" ) cBarra="bg-green-500" ; %>
                                    <div class="relative group">
                                        <div class="flex flex-col lg:flex-row justify-between lg:items-end mb-4 gap-2">
                                            <div>
                                                <p class="text-red-600 font-mono text-[10px] mb-1 tracking-widest">
                                                    DATA_LOG_ID: <%= v.transaccionId %>
                                                </p>
                                                <h4 class="text-2xl font-black italic uppercase text-white">
                                                    <%= nMoto %>
                                                </h4>
                                            </div>
                                            <div class="lg:text-right">
                                                <p class="text-3xl font-black italic text-white tracking-tighter">€<%=
                                                        precioStr %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="h-3 bg-black/80 border border-zinc-800 p-[2px]">
                                            <div class="progress-step h-full <%= cBarra %>"
                                                data-estado="<%= v.estado %>" style="width: 5%"></div>
                                        </div>

                                        <div
                                            class="mt-4 flex flex-col lg:flex-row justify-between items-center gap-4 bg-zinc-900/30 p-4 border border-zinc-900/50">
                                            <div class="flex items-center gap-3">
                                                <i class="fa-solid fa-headset text-red-600 text-lg"></i>
                                                <div>
                                                    <p
                                                        class="text-[8px] text-zinc-500 font-black uppercase tracking-widest">
                                                        Asistencia Técnica</p>
                                                    <p class="text-[10px] text-white font-bold italic uppercase">
                                                        ¿Problemas con el despliegue?</p>
                                                </div>
                                            </div>
                                            <a href="https://wa.me/584242464208?text=Hola%20Ducati%20Squadra%2C%20necesito%20asistencia%20con%20mi%20<%= nMoto %>%20(ID:%20<%= v.transaccionId %>)"
                                                target="_blank"
                                                class="w-full lg:w-auto flex items-center justify-center gap-2 text-[10px] font-black uppercase tracking-widest text-white bg-green-600 hover:bg-white hover:text-black transition-all px-6 py-3">
                                                <i class="fa-brands fa-whatsapp text-sm"></i>
                                                Contactar Crew
                                            </a>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div
                                                class="py-24 text-center border border-dashed border-zinc-900 bg-black/20">
                                                <p
                                                    class="text-zinc-700 font-black italic uppercase text-xs tracking-[0.5em]">
                                                    No data records found</p>
                                            </div>
                                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var bars = document.querySelectorAll('.progress-step');
            bars.forEach(function (bar) {
                var estado = bar.getAttribute('data-estado');
                var w = "25%";
                if (estado === "Pago Verificado") w = "50%";
                else if (estado === "Enviada") w = "75%";
                else if (estado === "Entregada") w = "100%";
                setTimeout(function () { bar.style.width = w; }, 400);
            });
        });
    </script>
</body>

</html>