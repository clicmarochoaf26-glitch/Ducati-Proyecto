<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ducati Scrambler Icon Dark | Estilo Urbano</title>
    <link rel="icon" type="image/png" href="/img/logo/logo.png">
    <link rel="apple-touch-icon" href="/img/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@300;900&family=Space+Mono&family=Inter:wght@400;900&display=swap');

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Lexend Deca', sans-serif;
            background: #0f0f0f;
            background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 30px 30px;
            color: #eee;
            margin: 0;
            overflow-x: hidden;
        }

        /* --- UI COMPONENTS --- */
        .btn-nav-garage {
            font-family: 'Space Mono', monospace;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            padding: 8px 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-nav-garage:hover {
            background: #fff;
            color: #000;
            border-color: #fff;
        }

        .wrapper-360 {
            width: 100%;
            height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            perspective: 1000px;
        }

        #moto-ducati {
            width: 85%;
            max-width: 750px;
            filter: brightness(0.2) grayscale(100%);
            transition: transform 0.1s ease-out, filter 0.8s ease;
            transform-style: preserve-3d;
        }

        .engine-on #moto-ducati {
            filter: brightness(1) grayscale(0%) drop-shadow(0 0 40px rgba(255, 255, 255, 0.1));
        }

        
        .hotspot {
            position: absolute;
            width: 20px;
            height: 20px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 100;
            transition: all 0.3s;
            opacity: 0;
            transform: scale(0);
        }

        .engine-on .hotspot {
            opacity: 1;
            transform: scale(1);
        }

        .hotspot::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: white;
            border-radius: 50%;
            animation: pulse-hotspot 2s infinite;
        }

        @keyframes pulse-hotspot {
            0% {
                transform: scale(1);
                opacity: 0.8;
            }

            100% {
                transform: scale(3);
                opacity: 0;
            }
        }

        .hotspot-card {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            background: white;
            color: black;
            padding: 12px;
            border-radius: 4px;
            font-size: 10px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.5);
        }

        .hotspot:hover .hotspot-card {
            opacity: 1;
            visibility: visible;
            bottom: 40px;
        }

        .telemetry-scrambler {
            font-family: 'Space Mono', monospace;
            background: #fff;
            color: #000;
            padding: 15px 25px;
            border-radius: 2px;
            box-shadow: 8px 8px 0px #333;
            pointer-events: none;
        }

        
        .scrambler-gallery {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(2, 300px);
            gap: 15px;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            background: #1a1a1a;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .item-big {
            grid-column: span 2;
            grid-row: span 2;
        }

        .item-small {
            grid-column: span 2;
            grid-row: span 1;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.2s ease;
            filter: brightness(0.6);
        }

        .gallery-item:hover img {
            transform: scale(1.08);
            filter: brightness(1);
        }

        
        .tech-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 2rem;
            transition: 0.3s;
        }

        .tech-card:hover {
            background: #fff;
            color: #000;
        }

        .btn-scrambler {
            background: #fff;
            color: #000;
            padding: 16px 45px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: 0.3s;
            border: 2px solid #fff;
        }

        .btn-scrambler:hover {
            background: transparent;
            color: #fff;
        }

        .vibrando {
            animation: soft-vibe 0.1s infinite;
        }

        @keyframes soft-vibe {

            0%,
            100% {
                transform: rotateY(var(--rot, 0deg)) translate(0, 0);
            }

            50% {
                transform: rotateY(var(--rot, 0deg)) translate(1px, 1px);
            }
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
        }
    </style>
</head>

<body>

    <div id="modalCompra"
        class="fixed inset-0 z-[5000] hidden bg-black/95 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white text-black w-full max-w-lg p-10 shadow-[20px_20px_0px_#333]">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-[2px] bg-black"></div>
                <p class="text-[10px] font-black uppercase tracking-widest">Reserva Scrambler Icon Dark</p>
            </div>
            <h3 class="text-5xl font-black uppercase leading-none mb-8">ÚNETE A LA <br>REBELIÓN.</h3>
            <form action="/comprar/<%= moto._id %>" method="POST" class="space-y-6">
                <div>
                    <label class="text-[8px] font-black uppercase text-zinc-500 block mb-2 italic">Concesionario
                        Oficial</label>
                    <select id="selectSede" name="sedeElegida" required
                        class="w-full bg-zinc-900 border border-zinc-800 p-4 text-xs font-bold text-white outline-none focus:border-red-600 appearance-none cursor-pointer">
                        <option value="Caracas, Venezuela">Garage Las Mercedes, Caracas</option>
                        <option value="Roma, Italia">Ducati Italia, Roma</option>
                        <option value="Madrid, España">Ducati España, Madrid</option>
                        <option value="Miami, Usa">Ducati USA, Miami </option>
                        <option value="Tokyo, Japan">Ducati Tokyo, Nishi</option>
                        <option value="Dubai, UAE">Ducati Dubai, Wheels of Arabia</option>
                        <option value="Dubai, UAE">Ducati Germany, Munich</option>
                    </select>
                </div>
                <div>
                    <label class="text-[9px] font-bold uppercase block mb-2 font-mono">Fecha de retiro</label>
                    <input type="date" name="fechaEntrega" required
                        class="w-full border-2 border-black p-4 text-xs font-bold outline-none bg-black text-white focus:bg-white">
                </div>
                <div class="mt-6 flex gap-3 p-4 bg-zinc-100 border-l-4 border-black">
                    <i class="fa-solid fa-location-dot text-[10px] mt-1"></i>
                    <p class="text-[10px] leading-tight text-zinc-700 font-mono uppercase">El retiro será en: <br>
                        <span id="sede-display" class="text-black font-black text-xs">Garage Las Mercedes,
                            Caracas</span>
                    </p>
                </div>
                <div class="border-y-2 border-black py-4 my-6">
                    <p class="text-[10px] uppercase font-mono mb-1 text-zinc-500">Total a Invertir:</p>
                    <p class="text-3xl font-black italic">
                        <%= moto.precio %>
                    </p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <button type="button" onclick="cerrarModal()"
                        class="text-[10px] font-black uppercase hover:underline">Ahora no</button>
                    <button type="submit"
                        class="bg-black text-white p-4 text-[10px] font-black uppercase hover:bg-zinc-800 transition">Confirmar
                        Reserva</button>
                </div>
            </form>
        </div>
    </div>

    <nav
        class="fixed top-0 w-full z-[200] bg-black/90 backdrop-blur-md border-b border-white/5 p-6 flex justify-between items-center">
        <div class="flex items-center gap-6">
            <a href="/"><img src="/img/logo/logo.png" alt="Ducati" class="h-4"></a>
            <a href="/" class="btn-nav-garage uppercase">
                <i class="fa-solid fa-chevron-left text-[8px]"></i>
                <span>Volver al inicio</span>
            </a>
        </div>
        <div class="flex items-center gap-8">
            <span class="hidden md:block text-[9px] font-mono tracking-[0.3em] uppercase opacity-50">Scrambler Icon Dark
                // Serie 05</span>
            <div class="flex gap-6 items-center">
                <% if (session) { %>
                    <a href="/perfil"
                        class="text-[10px] font-black uppercase text-white hover:opacity-70 transition italic">PERFIL</a>
                    <a href="/logout"
                        class="text-[10px] font-black uppercase text-zinc-500 hover:text-white transition">SALIR</a>
                    <% } else { %>
                        <a href="/login"
                            class="text-[10px] font-black uppercase text-white hover:opacity-70 transition">LOGIN</a>
                        <a href="/registro"
                            class="bg-white text-black px-4 py-2 text-[10px] font-black uppercase hover:bg-zinc-800 hover:text-white transition">REGISTRO</a>
                        <% } %>
            </div>
        </div>
    </nav>

    <section class="relative min-h-screen flex items-center pt-20">
        <div class="container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

            <div class="space-y-8">
                <div
                    class="inline-block px-3 py-1 border border-zinc-700 text-[10px] uppercase tracking-widest text-zinc-500 font-mono">
                    Urban Rebel Edition
                </div>
                <h1 class="text-7xl md:text-8xl font-black uppercase leading-[0.9]">
                    ALMA <br><span class="text-zinc-600 italic">DARK.</span>
                </h1>

                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-6 relative">
                        <div id="hint-start"
                            class="absolute -top-12 left-0 bg-white text-black text-[9px] font-black px-3 py-2 uppercase tracking-tighter animate-bounce after:content-[''] after:absolute after:top-full after:left-4 after:border-8 after:border-transparent after:border-t-white">
                            Click para encender la bestia
                        </div>

                        <button id="btn-start"
                            class="w-16 h-16 rounded-full border border-zinc-800 flex items-center justify-center hover:border-white transition-all group">
                            <i class="fa-solid fa-bolt-lightning text-zinc-700 group-hover:text-white"></i>
                        </button>



                        <button onclick="abrirModal()"
                            class="btn-scrambler shadow-[10px_10px_0px_rgba(255,255,255,0.05)]">Reservar</button>
                    </div>
                </div>

                <div class="pt-10 border-t border-zinc-900">
                    <div class="flex items-center gap-2 mb-6">
                        <i class="fa-solid fa-shield-halved text-white text-[10px]"></i>
                        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-white">4 Ever Ducati // Garantía
                            de 4 años incluida</p>
                    </div>

                    <div class="grid grid-cols-3 gap-8">
                        <div>
                            <p class="text-[9px] uppercase tracking-widest text-zinc-600 mb-2 font-mono">Motor Desmo</p>
                            <p class="text-3xl font-black">803 <span class="text-xs font-light">cc</span></p>
                        </div>
                        <div>
                            <p class="text-[9px] uppercase tracking-widest text-zinc-600 mb-2 font-mono">Potencia</p>
                            <p class="text-3xl font-black">73 <span class="text-xs font-light">hp</span></p>
                        </div>
                        <div>
                            <p class="text-[9px] uppercase tracking-widest text-white mb-2 italic font-mono">Precio</p>
                            <p class="text-3xl font-black">
                                <%= moto.precio %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="wrapper-360" id="sensor-giro">
                <div class="absolute top-0 right-0 telemetry-scrambler z-[150]">
                    <p class="text-[10px] uppercase font-black mb-1 font-mono">Perspective</p>
                    <span id="txt-grados" class="text-3xl font-black">0°</span>
                </div>

                <div class="relative w-[85%] max-w-[750px] flex items-center justify-center">
                    <div class="hotspot" style="top: 50%; left: 55%;">
                        <i class="fa-solid fa-plus text-[8px] text-black"></i>
                        <div class="hotspot-card">
                            <p class="font-black uppercase mb-1">Motor L-Twin</p>
                            <p>Distribución Desmodrómica. Puro carácter Ducati.</p>
                        </div>
                    </div>

                    <div class="hotspot" style="top: 70%; left: 35%;">
                        <i class="fa-solid fa-plus text-[8px] text-black"></i>
                        <div class="hotspot-card">
                            <p class="font-black uppercase mb-1">Frenos Brembo</p>
                            <p>Seguridad total Bosch Cornering ABS.</p>
                        </div>
                    </div>

                    <div class="hotspot" style="top: 30%; left: 45%;">
                        <i class="fa-solid fa-plus text-[8px] text-black"></i>
                        <div class="hotspot-card">
                            <p class="font-black uppercase mb-1">Faro LED DRL</p>
                            <p>Diseño icónico Serie 05.</p>
                        </div>
                    </div>

                    <img id="moto-ducati" src="<%= moto.img %>" alt="<%= moto.nombre %>"
                        class="w-full h-auto block transition-filter duration-700">
                </div>
            </div>
        </div>
    </section>
    <section class="py-24 bg-zinc-950 border-y border-white/5">
        <div class="container mx-auto px-6">
            <h2 class="text-[10px] font-black tracking-[0.5em] text-zinc-700 mb-12 uppercase italic">Technical_Sheet_05
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="tech-card">
                    <p class="font-mono text-[9px] text-zinc-500 uppercase mb-4">// Transmisión</p>
                    <h4 class="text-xl font-black uppercase">6 Velocidades</h4>
                    <p class="text-[10px] mt-2 text-zinc-400">Ducati Quick Shift (DQS) disponible como accesorio.</p>
                </div>
                <div class="tech-card">
                    <p class="font-mono text-[9px] text-zinc-500 uppercase mb-4">// Electrónica</p>
                    <h4 class="text-xl font-black uppercase">Ride by Wire</h4>
                    <p class="text-[10px] mt-2 text-zinc-400">Dos modos de conducción: Road y Sport con control de
                        tracción.</p>
                </div>
                <div class="tech-card">
                    <p class="font-mono text-[9px] text-zinc-500 uppercase mb-4">// Seguridad</p>
                    <h4 class="text-xl font-black uppercase">Cornering ABS</h4>
                    <p class="text-[10px] mt-2 text-zinc-400">Bosch optimizado para curvas de serie.</p>
                </div>
                <div class="tech-card">
                    <p class="font-mono text-[9px] text-zinc-500 uppercase mb-4">// Pantalla</p>
                    <h4 class="text-xl font-black uppercase">TFT 4.3"</h4>
                    <p class="text-[10px] mt-2 text-zinc-400">Nueva interfaz a color con Ducati Multimedia System.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-[#0a0a0a]">
        <div class="container mx-auto px-6">
            <div class="flex justify-between items-end mb-12">
                <h2 class="text-[10px] font-black tracking-[0.5em] text-zinc-700 uppercase italic">Multimedia de Fábrica
                </h2>
                <p class="text-[10px] font-mono text-zinc-500">BORGO PANIGALE LAB // 2026</p>
            </div>
            <div class="scrambler-gallery">
                <div class="gallery-item item-big"><img src="/img/detalle/icon.png" alt="Icon Dark"></div>
                <div class="gallery-item item-small"><img src="/img/detalle/1.jpg" alt="Detail"></div>
                <div class="gallery-item item-small"><img
                        src="/img/detalle/Scrambler-Icon-Dark-MY25-pagina-prodotto-media-slider-1920x1080-04.jpg"
                        alt="L-Twin"></div>
                <div class="gallery-item item-big"><img
                        src="/img/detalle/Scrambler-Icon-Dark-MY25-pagina-prodotto-media-slider-1920x1080-07.jpg"
                        alt="Action"></div>
            </div>
        </div>
    </section>

    <footer class="py-32 bg-black border-t border-zinc-900">
        <div class="container mx-auto px-6 text-center">
            <h2 class="text-6xl md:text-8xl font-black uppercase mb-4 text-white leading-none">THE LAND <br> <span
                    class="text-zinc-800 italic" style="-webkit-text-stroke: 1px #333; color: transparent;">OF
                    JOY.</span></h2>
            <div class="flex flex-col items-center gap-6">
                <button onclick="abrirModal()"
                    class="group relative px-10 py-5 bg-white text-black font-black uppercase text-[10px] tracking-[0.4em] hover:bg-zinc-200 transition-all duration-300">
                    Descubrir la Bestia
                    <div
                        class="absolute inset-0 border border-white translate-x-2 translate-y-2 -z-10 group-hover:translate-x-0 group-hover:translate-y-0 transition-all">
                    </div>
                </button>
            </div>
        </div>
    </footer>

    <audio id="audio-scrambler" preload="auto">
        <source src="/img/detalle/ducati-scrambler-bike-exhaust-28235.mp3" type="audio/mpeg">
    </audio>

    <script>
        const modal = document.getElementById('modalCompra');
        const sensor = document.getElementById('sensor-giro');
        const motoImg = document.getElementById('moto-ducati');
        const btnStart = document.getElementById('btn-start');
        const txtGrados = document.getElementById('txt-grados');
        const audio = document.getElementById('audio-scrambler');
        const selectSede = document.getElementById('selectSede');
        const displaySede = document.getElementById('sede-display');

        if (selectSede && displaySede) {
            selectSede.addEventListener('change', () => {
                displaySede.innerText = selectSede.options[selectSede.selectedIndex].text;
            });
        }

        function abrirModal() {
            const haySesion = "<%= session ? 'true' : 'false' %>" === "true";
            if (!haySesion) {
                Swal.fire({
                    title: '<span style="font-family: \'Inter\'; font-weight: 900;">ACCESO RESTRINGIDO</span>',
                    html: `<p style="font-family: 'Space Mono'; font-size: 12px; color: #666;">// AUTH_REQUIRED</p><p style="font-family: 'Inter'; font-size: 14px;">Inicia sesión para reservar tu Scrambler.</p>`,
                    background: '#0a0a0a',
                    color: '#fff',
                    showCancelButton: true,
                    confirmButtonText: 'IR AL LOGIN',
                    confirmButtonTextColor: '#000'
                }).then((result) => { if (result.isConfirmed) window.location.href = '/login'; });
            } else { modal.classList.remove('hidden'); }
        }

        function cerrarModal() { modal.classList.add('hidden'); }

        function handleRotation(clientX) {
            if (!sensor) return;
            const rect = sensor.getBoundingClientRect();
            const x = clientX - rect.left;
            const rotation = ((x / rect.width) - 0.5) * 60;
            motoImg.style.transform = `rotateY(${rotation}deg)`;
            motoImg.style.setProperty('--rot', `${rotation}deg`);
            txtGrados.innerText = `${Math.round(rotation)}°`;

            document.querySelectorAll('.hotspot').forEach(h => {
                h.style.transform = `translateX(${rotation * -0.5}px) scale(1)`;
            });
        }

        if (sensor && motoImg) {
            sensor.addEventListener('mousemove', (e) => handleRotation(e.clientX));
            sensor.addEventListener('touchmove', (e) => {
                if (e.cancelable) e.preventDefault();
                handleRotation(e.touches[0].clientX);
            }, { passive: false });

            const resetRotation = () => {
                motoImg.style.transform = 'rotateY(0deg)';
                motoImg.style.setProperty('--rot', `0deg`);
                txtGrados.innerText = `0°`;
                document.querySelectorAll('.hotspot').forEach(h => h.style.transform = `translateX(0) scale(1)`);
            };
            sensor.addEventListener('mouseleave', resetRotation);
            sensor.addEventListener('touchend', resetRotation);
        }

        btnStart.addEventListener('click', () => {
            const isOn = document.body.classList.toggle('engine-on');

            
            const hint = document.getElementById('hint-start');
            if (hint) hint.style.display = 'none';

            if (isOn) {
                audio?.play().catch(() => { });
                btnStart.querySelector('i').className = 'fa-solid fa-stop text-white';
                motoImg.classList.add('vibrando');
            } else {
                audio?.pause();
                btnStart.querySelector('i').className = 'fa-solid fa-bolt-lightning text-zinc-700';
                motoImg.classList.remove('vibrando');
            }
        });


        document.addEventListener('keydown', (e) => { if (e.key === "Escape") cerrarModal(); });
    </script>
</body>

</html>