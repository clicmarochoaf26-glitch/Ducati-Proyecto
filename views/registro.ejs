<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ducati | Registro de Piloto</title>
    <link rel="icon" type="image/png" href="/img/logo/logo.png">
    <link rel="apple-touch-icon" href="/img/logo/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');

        body {
            background: radial-gradient(circle, #1a1a1a 0%, #000000 100%);
            font-family: 'Inter', sans-serif;
        }

        .carbon-input {
            background: #0a0a0a;
            border: 2px solid #222;
            transition: all 0.3s;
            color: white;
        }

        .carbon-input:focus {
            outline: none;
            border-color: #e31837;
            box-shadow: 0 0 15px rgba(227, 24, 55, 0.1);
        }

        .status-error {
            border-color: #e31837 !important;
        }

        .status-success {
            border-color: #00ff41 !important;
        }
    </style>
</head>

<body class="text-white min-h-screen flex items-center justify-center py-8 px-4">

    <div class="max-w-2xl w-full bg-black/60 p-8 md:p-12 rounded-sm border border-zinc-900 shadow-2xl backdrop-blur-md">
        <div class="text-center mb-10">
            <h1 class="text-4xl font-black italic tracking-tighter uppercase leading-none">DUCATI</h1>
            <p class="text-red-600 text-[10px] tracking-[0.5em] uppercase font-bold mt-2">Crea tu Perfil Oficial</p>
        </div>

        <form action="/registro" method="POST" class="space-y-6" id="ducatiForm">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label
                        class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2">Nombre</label>
                    <input type="text" name="nombre" required class="w-full carbon-input p-4 text-sm rounded-sm"
                        placeholder="Marc">
                </div>
                <div>
                    <label
                        class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2">Apellido</label>
                    <input type="text" name="apellido" required class="w-full carbon-input p-4 text-sm rounded-sm"
                        placeholder="Márquez">
                </div>
            </div>

            <div>
                <label class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2">Email</label>
                <input type="email" name="correo" required class="w-full carbon-input p-4 text-sm rounded-sm"
                    placeholder="moto@ducati.com">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2">Sede
                        (País)</label>
                    <select name="pais" id="paisSelect" required
                        class="w-full carbon-input p-4 text-sm rounded-sm appearance-none cursor-pointer">
                        <option value="" disabled selected>Selecciona Ubicación</option>
                        <option value="Venezuela" data-prefix="+58">🇻🇪 Venezuela</option>
                        <option value="Italia" data-prefix="+39">🇮🇹 Italia</option>
                        <option value="España" data-prefix="+34">🇪🇸 España</option>
                        <option value="USA" data-prefix="+1">🇺🇸 USA</option>
                    </select>
                </div>
                <div>
                    <label
                        class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2">Celular</label>
                    <div class="flex">
                        <span id="prefijoVisor"
                            class="bg-zinc-900 border-2 border-zinc-800 border-r-0 p-4 text-sm text-zinc-500 min-w-[75px] text-center rounded-l-sm font-mono flex items-center justify-center">--</span>
                        <input type="number" name="celular" required
                            class="w-full carbon-input p-4 text-sm rounded-r-sm border-l-0" placeholder="0000000">
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2 text-red-600">Moto
                    Preferida</label>
                <select name="moto_preferida" required
                    class="w-full carbon-input p-4 text-sm rounded-sm appearance-none cursor-pointer">
                    <option value="" disabled selected>Selecciona tu Bestia</option>
                    <% motos.forEach(moto=> { %>
                        <option value="<%= moto.nombre %>">
                            <%= moto.nombre %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <div>
                <label class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2">Usuario</label>
                <input type="text" name="username" required class="w-full carbon-input p-4 text-sm rounded-sm"
                    placeholder="ducati_pilot_93">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label
                        class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2 italic">Contraseña
                        (Mín. 8)</label>
                    <input type="password" id="passwordInput" name="password" required
                        class="w-full carbon-input p-4 text-sm rounded-sm" placeholder="••••••••">
                </div>
                <div>
                    <label
                        class="block text-[9px] font-bold uppercase tracking-widest text-zinc-500 mb-2 italic">Confirmar</label>
                    <input type="password" id="confirmPasswordInput" required
                        class="w-full carbon-input p-4 text-sm rounded-sm" placeholder="••••••••">
                </div>
            </div>

            <p id="passMsg" class="text-[8px] italic uppercase font-black tracking-widest text-zinc-600 text-center">
                SISTEMA: ESPERANDO TELEMETRÍA...</p>

            <button type="submit"
                class="w-full bg-red-600 hover:bg-white hover:text-black text-white font-black py-4 rounded-sm uppercase italic text-xs tracking-[0.2em] transition-all duration-500 shadow-lg shadow-red-600/20">
                Confirmar Inscripción
            </button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const passInput = document.getElementById('passwordInput');
        const confirmInput = document.getElementById('confirmPasswordInput');
        const passMsg = document.getElementById('passMsg');
        const paisSelect = document.getElementById('paisSelect');
        const prefijoVisor = document.getElementById('prefijoVisor');

        paisSelect.addEventListener('change', function () {
            const option = this.options[this.selectedIndex];
            prefijoVisor.innerText = option.getAttribute('data-prefix');
            prefijoVisor.className = "bg-zinc-900 border-2 border-zinc-800 border-r-0 p-4 text-sm text-red-600 min-w-[75px] text-center rounded-l-sm font-mono flex items-center justify-center";
        });

        function validar() {
            const val = passInput.value;
            const confVal = confirmInput.value;
            const regex = /^(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*]).{8,}$/;

            passInput.classList.remove('status-error', 'status-success');
            confirmInput.classList.remove('status-error', 'status-success');

            if (regex.test(val) && val === confVal) {
                passInput.classList.add('status-success');
                confirmInput.classList.add('status-success');
                passMsg.innerText = "RACE READY - CONFIGURACIÓN SINCRONIZADA";
                passMsg.className = "text-[8px] italic uppercase font-black tracking-widest text-green-500 text-center";
            } else {
                passInput.classList.add('status-error');
                passMsg.innerText = "ERROR - REQUIERE MAYÚSCULA, NÚMERO Y SÍMBOLO";
                passMsg.className = "text-[8px] italic uppercase font-black tracking-widest text-red-600 text-center";
            }
        }

        passInput.addEventListener('input', validar);
        confirmInput.addEventListener('input', validar);

        window.addEventListener('load', () => {
            const error = "<%= error_type || '' %>";
            if (error === 'user_exists') {
                Swal.fire({ title: 'ACCESO DENEGADO', text: 'El piloto ya existe.', icon: 'warning', background: '#111', color: '#fff', confirmButtonColor: '#ce1d19' });
            }
        });
    </script>
</body>

</html>