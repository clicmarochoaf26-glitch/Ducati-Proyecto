    <script>
        async function editarPrecio(id) {
            const nuevoPrecio = prompt("💵 Ingrese el nuevo precio (USD) para esta Ducati:");
            if (nuevoPrecio && !isNaN(nuevoPrecio)) {
                try {
                    const response = await fetch(`/api/motos/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ precio: nuevoPrecio })
                    });
                    if (response.ok) location.reload();
                    else alert("❌ Error al actualizar.");
                } catch (err) { console.error(err); }
            }
        }

        async function eliminarMoto(id) {
            if (confirm("⚠️ ¿Eliminar este modelo?")) {
                try {
                    const response = await fetch(`/api/motos/${id}`, { method: 'DELETE' });
                    if (response.ok) location.reload();
                    else alert("❌ Error al eliminar.");
                } catch (err) { console.error(err); }
            }
        }

        const btnMenu = document.getElementById('btn-menu');
        const menuMobile = document.getElementById('menu-mobile');
        const iconMenu = document.getElementById('icon-menu');

        function toggleMenu() {

            menuMobile.classList.toggle('hidden');


            if (menuMobile.classList.contains('hidden')) {
                iconMenu.classList.replace('fa-xmark', 'fa-bars-staggered');
            } else {
                iconMenu.classList.replace('fa-bars-staggered', 'fa-xmark');
            }
        }

        btnMenu.addEventListener('click', toggleMenu);
    </script>
